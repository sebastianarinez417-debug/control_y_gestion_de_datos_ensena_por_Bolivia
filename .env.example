# Copie este archivo como .env y ajuste los valores. No suba .env al repositorio.

# Base de datos. Por defecto SQLite en data/presupuesto.db. Para PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://usuario:clave@localhost:5432/presupuesto
DATABASE_URL=

# Clave para firmar los tokens de sesión. Si se deja vacía se genera una aleatoria en data/.secret_key
SECRET_KEY=

# Administrador inicial (solo se usa la primera vez que arranca el sistema).
# Si ADMIN_PASSWORD queda vacío se genera una contraseña aleatoria y se muestra en la consola
# y en data/credenciales_iniciales.txt
ADMIN_USUARIO=admin
ADMIN_PASSWORD=

TOKEN_HORAS=8
MAX_ARCHIVO_MB=25
CORS_ORIGENES=http://localhost:5173,http://127.0.0.1:5173
# Acepta además orígenes de la red local (192.168.x.x, 10.x.x.x, 172.16-31.x.x). false para desactivar.
CORS_RED_LOCAL=true

# --- Frontend (Vite, se leen al ejecutar npm run dev) ---
# VITE_HOST=0.0.0.0           # 0.0.0.0 = accesible desde la red local; 127.0.0.1 = solo este equipo
# VITE_BACKEND=http://127.0.0.1:8000   # dónde está FastAPI visto desde el equipo que ejecuta Vite
INSTITUCION=ENSEÑA POR BOLIVIA EXB
